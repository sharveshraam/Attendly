# Attendly mobile — PUBLIC client configuration (committed).
#
# These EXPO_PUBLIC_* values are embedded into the app bundle at BUILD time by
# Metro. They are the Supabase project URL and the PUBLISHABLE key, which is
# browser/client-safe by design because Row Level Security protects every row.
# This is NOT a secret and NOT a service-role key. Committing it here guarantees
# that `expo export`, `expo run:android`, and EAS builds all embed the config, so
# the installed APK never shows a "configure me" screen.
#
# Local overrides can still be placed in .env.local (git-ignored), which Expo
# loads with higher priority. EAS builds also receive these via eas.json `env`.

EXPO_PUBLIC_SUPABASE_URL=https://gavlxbxgxdormbfhtzlo.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BDmWozWyO2M7T-ziVuiVtQ_2nJIF2kb
