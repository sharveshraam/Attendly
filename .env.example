# ── Attendly website · browser-safe configuration ───────────────────────────
# Copy to .env.local for local development, or set these in the Vercel project.
# These are PUBLIC values (the Supabase publishable/anon key is designed for the
# browser). Authorization is enforced by the existing RLS policies, not by these
# keys. NEVER add a service-role key, database password or AI provider secret to
# this file or to any NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy alias accepted by the client helpers if your project still uses an
# anon key instead of a publishable key. Do not set both keys in production.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Auth email links use the current browser origin automatically; no APP_URL
# variable is read by the code. The deployed origin still has to be added to the
# Supabase Auth redirect allow-list (an additive config change that needs owner
# approval). localhost:3000 is already allowed for local development.

# No service-role key, AI/OCR key or web-push sender is used by this frontend:
# the live project has no Edge Functions, no notes table and no push sender.
