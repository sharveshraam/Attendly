{
  "expo": {
    "name": "Attendly",
    "slug": "attendly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "attendly",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1020",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sharveshraam.attendly",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attendly needs photo access so you can import timetable and academic-calendar images.",
        "NSUserNotificationsUsageDescription": "Attendly sends class, attendance and deadline reminders you configure."
      }
    },
    "android": {
      "package": "com.sharveshraam.attendly",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "permissions": ["POST_NOTIFICATIONS", "READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES", "VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B7CFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attendly needs photo access so you can import timetable and academic-calendar images."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
